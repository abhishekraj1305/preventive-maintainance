# Copy to .env for LOCAL development. Never commit .env or account credentials.
DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://maintenance:password@127.0.0.1:5432/maintenance_dev
ALLOWED_HOSTS=localhost,127.0.0.1
DEMO_MODE=1
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password
DEMO_PASSWORD=replace-with-a-different-strong-temporary-password
# Only for the first demo deployment. Seed is idempotent, but disable after setup.
SEED_DEMO=1
